  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://kcverde.github.io/tapeleaf/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcverde/tapeleaf.git"
  },
  "bugs": {
    "url": "https://github.com/kcverde/tapeleaf/issues"
  },
  "keywords": [
    "obsidian",
    "voice-notes",
    "voice-recorder",
    "pwa",
    "offline-first",
    "gemini",
    "transcription",
    "markdown",
    "local-first"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
