# Gemini API key (leave blank for offline demo fallback)
GEMINI_API_KEY=

# Gemini model used for single-call multilingual audio transcription & translation
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional passcode lock for all /api/* endpoints (recommended for public deployments; leave blank for local dev)
APP_PASSCODE=

# Optional dedicated cookie signing secret (defaults to a key derived from APP_PASSCODE)
SESSION_SECRET=

# Set to 1 ONLY when running behind a trusted HTTPS reverse proxy (Caddy/Railway/Fly) that strips inbound forwarded headers
TRUST_PROXY=0

# Directory storing notes/*.md and notes/audio/*
DATA_DIR=./data

# Server binding
PORT=3001
HOST=127.0.0.1
